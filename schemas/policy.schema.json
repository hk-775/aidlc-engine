{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidlc:schema:policy:v1",
  "title": "AIDLC policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "required_artifacts",
    "human_gates",
    "agent_permissions",
    "transition_controls",
    "artifact_controls",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "required_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "requirements",
        "design",
        "implementation",
        "verification",
        "release"
      ],
      "properties": {
        "discovery": {
          "$ref": "#/$defs/artifactTypes"
        },
        "requirements": {
          "$ref": "#/$defs/artifactTypes"
        },
        "design": {
          "$ref": "#/$defs/artifactTypes"
        },
        "implementation": {
          "$ref": "#/$defs/artifactTypes"
        },
        "verification": {
          "$ref": "#/$defs/artifactTypes"
        },
        "release": {
          "$ref": "#/$defs/artifactTypes"
        }
      }
    },
    "human_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design->implementation",
        "verification->release"
      ],
      "properties": {
        "discovery->requirements": {
          "$ref": "#/$defs/gate"
        },
        "requirements->design": {
          "$ref": "#/$defs/gate"
        },
        "design->implementation": {
          "allOf": [
            {
              "$ref": "#/$defs/gate"
            },
            {
              "properties": {
                "required_roles": {
                  "contains": {
                    "const": "technical_reviewer"
                  }
                },
                "minimum_approvals": {
                  "minimum": 1
                }
              }
            }
          ]
        },
        "implementation->verification": {
          "$ref": "#/$defs/gate"
        },
        "verification->release": {
          "allOf": [
            {
              "$ref": "#/$defs/gate"
            },
            {
              "properties": {
                "required_roles": {
                  "allOf": [
                    {
                      "contains": {
                        "const": "release_manager"
                      }
                    },
                    {
                      "contains": {
                        "const": "risk_owner"
                      }
                    }
                  ]
                },
                "minimum_approvals": {
                  "minimum": 2
                }
              }
            }
          ]
        }
      }
    },
    "agent_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propose_work",
        "submit_artifact",
        "complete_assigned_work",
        "propose_transition",
        "merge",
        "deploy",
        "release",
        "accept_risk",
        "approve_transition",
        "satisfy_human_gate",
        "bypass_gate"
      ],
      "properties": {
        "propose_work": {
          "type": "boolean"
        },
        "submit_artifact": {
          "type": "boolean"
        },
        "complete_assigned_work": {
          "type": "boolean"
        },
        "propose_transition": {
          "type": "boolean"
        },
        "merge": {
          "const": false
        },
        "deploy": {
          "const": false
        },
        "release": {
          "const": false
        },
        "accept_risk": {
          "const": false
        },
        "approve_transition": {
          "const": false
        },
        "satisfy_human_gate": {
          "const": false
        },
        "bypass_gate": {
          "const": false
        }
      }
    },
    "transition_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_independent_approval",
        "require_human_approval_for_all_transitions",
        "block_with_open_assignments"
      ],
      "properties": {
        "require_independent_approval": {
          "const": true
        },
        "require_human_approval_for_all_transitions": {
          "const": true
        },
        "block_with_open_assignments": {
          "type": "boolean"
        }
      }
    },
    "artifact_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_algorithm",
        "agent_submission_requires_active_assignment"
      ],
      "properties": {
        "digest_algorithm": {
          "const": "sha256"
        },
        "agent_submission_requires_active_assignment": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_artifacts",
        "max_open_assignments",
        "max_pending_proposals"
      ],
      "properties": {
        "max_artifacts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_open_assignments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_pending_proposals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  },
  "$defs": {
    "artifactTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_roles",
        "minimum_approvals"
      ],
      "properties": {
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          }
        },
        "minimum_approvals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
